AddDefaultCharset UTF-8
DirectoryIndex index.html

# Журнал согласий и внутренняя документация не должны быть доступны из браузера.
# Закрываем поимённо, а не все .md подряд: prices.md — публичный машиночитаемый
# прайс для ИИ-агентов, он должен отдаваться.
<IfModule mod_authz_core.c>
  <FilesMatch "\.log$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(README|reviews-draft)\.md$">
    Require all denied
  </FilesMatch>
</IfModule>

RedirectMatch 403 ^/logs/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/markdown .md
  AddCharset UTF-8 .md
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 180 days"
  ExpiresByType image/webp "access plus 180 days"
  ExpiresByType image/png "access plus 180 days"
  ExpiresByType image/x-icon "access plus 180 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Канонический адрес: https://shtukatur74.ru без www.
#
# Проверяются ДВА признака защищённого соединения. На части хостингов SSL
# терминируется на балансировщике, до Apache запрос доходит уже по http,
# и переменная HTTPS остаётся пустой — правило с одним условием %{HTTPS} off
# в такой схеме зацикливает сайт. Заголовок X-Forwarded-Proto закрывает
# этот случай.
#
# ЕСЛИ ПОСЛЕ ЗАЛИВКИ САЙТ УШЁЛ В БЕСКОНЕЧНЫЙ РЕДИРЕКТ (ERR_TOO_MANY_REDIRECTS) —
# закомментируйте весь блок ниже, сайт немедленно вернётся. Значит хостинг
# сообщает о протоколе как-то ещё, и условие нужно подобрать отдельно.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https и одновременно www → без www, одним переходом
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://shtukatur74.ru/$1 [R=301,L]

  # https://www.shtukatur74.ru → https://shtukatur74.ru
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://shtukatur74.ru/$1 [R=301,L]
</IfModule>

# HSTS намеренно не включён. Заголовок запрещает браузеру обращаться к сайту
# по http на указанный срок, и отменить это досрочно нельзя: если сертификат
# однажды не продлится, сайт станет недоступен до конца max-age. Включать
# имеет смысл через несколько месяцев стабильной работы автопродления:
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# </IfModule>

# Отдельная страница 404, а не редирект на главную: отдача главной с кодом
# 200 на несуществующий адрес — это soft 404, поисковики считают такие
# страницы дублями и портят индекс.
ErrorDocument 404 /404.html
