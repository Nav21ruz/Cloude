Options -Indexes
Options -MultiViews

# ── CHARSET ──────────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── MIME TYPES ───────────────────────────────────────────────────────────────
AddType image/svg+xml .svg
AddType application/json .json
AddType text/css .css
AddType application/javascript .js

# ── MOD_REWRITE (чистые URL без .html) ───────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Если файл или папка реально существуют — не трогаем
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Перенаправления: /about → /about.html и т.д.
  RewriteRule ^services$   services.html   [L]
  RewriteRule ^projects$   projects.html   [L]
  RewriteRule ^about$      about.html      [L]
  RewriteRule ^contact$    contact.html    [L]
  RewriteRule ^privacy$    privacy.html    [L]
  RewriteRule ^calculator$ calculator.html [L]
  RewriteRule ^admin$      admin/          [L]
</IfModule>

# ── КЭШИРОВАНИЕ ──────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — 1 час
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS / JS — 1 день
  ExpiresByType text/css                   "access plus 1 day"
  ExpiresByType application/javascript     "access plus 1 day"

  # Изображения и шрифты — 1 месяц
  ExpiresByType image/svg+xml              "access plus 1 month"
  ExpiresByType image/png                  "access plus 1 month"
  ExpiresByType image/jpeg                 "access plus 1 month"
  ExpiresByType image/webp                 "access plus 1 month"
  ExpiresByType font/woff2                 "access plus 1 month"
</IfModule>

# ── GZIP-СЖАТИЕ ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── ЗАГОЛОВКИ БЕЗОПАСНОСТИ ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Запрет показа сайта во фрейме
  Header always set X-Frame-Options "DENY"

  # Защита от MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Реферер
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # XSS-защита (legacy)
  Header always set X-XSS-Protection "1; mode=block"

  # Ограничение разрешений браузера
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://mc.yandex.ru; frame-ancestors 'none';"
</IfModule>

# ── СТРАНИЦА ОШИБКИ 404 ──────────────────────────────────────────────────────
ErrorDocument 404 /index.html
