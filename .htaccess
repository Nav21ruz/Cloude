Options -Indexes
Options -MultiViews

# ── CHARSET ──────────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── MIME TYPES ───────────────────────────────────────────────────────────────
AddType image/svg+xml .svg
AddType application/json .json
AddType text/css .css
AddType application/javascript .js

# ── MOD_REWRITE (чистые URL без .html) ───────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Передаём заголовок Authorization в PHP (Apache обрезает его по умолчанию)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Если файл или папка реально существуют — не трогаем
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Перенаправления: /about → /about.html и т.д.
  RewriteRule ^services$                    services.html                      [L]
  RewriteRule ^projects$                    projects.html                      [L]
  RewriteRule ^about$                       about.html                         [L]
  RewriteRule ^contact$                     contact.html                       [L]
  RewriteRule ^privacy$                     privacy.html                       [L]
  RewriteRule ^calculator$                  calculator.html                    [L]
  RewriteRule ^blog$                        blog.html                          [L]
  RewriteRule ^baza-znanii$                 baza-znanii/index.html             [L]
  RewriteRule ^ceny$                        ceny.html                          [L]
  RewriteRule ^remont-ofisov$               remont-ofisov.html                 [L]
  RewriteRule ^remont-restoranov$           remont-restoranov.html             [L]
  RewriteRule ^remont-torgovyh-zalov$       remont-torgovyh-zlov.html          [L]
  RewriteRule ^remont-meditsinskih-centrov$ remont-meditsinskih-centrov.html   [L]
  RewriteRule ^remont-skladov$              remont-skladov.html                [L]
  RewriteRule ^remont-kafe$                 remont-kafe.html                   [L]
  RewriteRule ^remont-fitnes-centrov$       remont-fitnes-centrov.html         [L]
  RewriteRule ^remont-magazinov$            remont-magazinov.html              [L]
  RewriteRule ^remont-pod-klyuch$           remont-pod-klyuch-chelyabinsk.html [L]
  RewriteRule ^admin$                       admin/                             [L]
</IfModule>

# ── КЭШИРОВАНИЕ ──────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — 1 час
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS / JS — 1 неделя
  ExpiresByType text/css                   "access plus 1 week"
  ExpiresByType application/javascript     "access plus 1 week"

  # Изображения и шрифты — 1 месяц
  ExpiresByType image/svg+xml              "access plus 1 month"
  ExpiresByType image/png                  "access plus 1 month"
  ExpiresByType image/jpeg                 "access plus 1 month"
  ExpiresByType image/webp                 "access plus 1 month"
  ExpiresByType font/woff2                 "access plus 1 year"
</IfModule>

# ── GZIP-СЖАТИЕ ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── ЗАГОЛОВКИ БЕЗОПАСНОСТИ ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Запрет показа сайта во фрейме
  Header always set X-Frame-Options "DENY"

  # Защита от MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Реферер
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # XSS-защита (legacy)
  Header always set X-XSS-Protection "1; mode=block"

  # Ограничение разрешений браузера
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: blob:; connect-src 'self' https://mc.yandex.ru; frame-ancestors 'none';"
</IfModule>

# ── СТРАНИЦА ОШИБКИ 404 ──────────────────────────────────────────────────────
ErrorDocument 404 /index.html

# ── ЗАЩИТА КОНФИГУРАЦИОННЫХ ФАЙЛОВ ───────────────────────────────────────────
<FilesMatch "^(config\.php|\.brute_lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>
